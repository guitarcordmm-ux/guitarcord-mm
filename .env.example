# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# Supabase browser configuration (publishable/anon key only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin login convenience mapping. Authorization itself is NOT based on these values;
# database access is controlled by the Supabase Auth app_metadata role=admin.
VITE_ADMIN_USERNAME=
VITE_ADMIN_EMAIL=

# Cloudflare Pages Functions should define these server-side variables too:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
